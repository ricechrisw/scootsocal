# Database — local SQLite (zero-install). For hosted Postgres, see README.
DATABASE_URL="file:./dev.db"

# Public site URL (no trailing slash). Used for Stripe success/cancel URLs.
APP_URL="http://localhost:3000"

# Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Admin login (seeded on npm run db:seed)
ADMIN_EMAIL="admin@scootsocal.com"
ADMIN_PASSWORD="change-me-now"
ADMIN_NAME="Admin"

# Signed admin session cookie
AUTH_SECRET="generate-a-long-random-string"

# Optional: Resend API key for transactional email. If empty, emails are logged only.
RESEND_API_KEY=
